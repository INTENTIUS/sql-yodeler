{
  "name": "yodel-apply",
  "op": "migrate-dev",
  "step": {
    "kind": "sql-migrate",
    "environment": "{target}",
    "spec": "yodel-waves.json"
  },
  "standDown": true,
  "branches": [
    "main"
  ],
  "waves": [
    {
      "name": "dev",
      "runs": [
        {
          "target": "dev",
          "op": "migrate-dev"
        }
      ],
      "gate": "always"
    },
    {
      "name": "prod",
      "runs": [
        {
          "target": "prod",
          "op": "migrate-prod"
        }
      ],
      "gate": "always"
    }
  ],
  "gateName": "yodel-apply-wave-{k}"
}
