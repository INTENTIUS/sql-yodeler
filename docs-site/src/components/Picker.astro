---
// The home page's first choice: the database and the forge as switches, the
// four starting points as tiles, and the roles as a line of links. Two cards
// then say what works for that pick (the start's list, the database's and the
// forge's line, and how many claims hold on that database) and the first step
// (the start's command for that database, and the page to follow). Every list
// comes from docs-site/rooms.mjs, the room pages' source, and the count from
// scenarios/claims-record.json at build time.
//
// The first pick (Start a new schema, ClickHouse, GitHub) is rendered here, so
// the cards read the same without script. Each tile is a link to its room:
// with script, a click on a tile that is not picked picks it instead, and a
// click on the picked one opens the room. The script keeps the pick in
// localStorage and writes Starlight's synced-tab keys, so pages with
// ClickHouse/Postgres or GitHub/GitLab/Forgejo tabs open on the same choice.
import { DIALECTS, FORGES, ROLES, ROOMS, STARTS } from '../../rooms.mjs';
import record from '../../../scenarios/claims-record.json';
import Hat from './Hat.astro';

type Link = { label: string; href: string };

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
/** A line of rooms.mjs as HTML: `code` spans as <code>, the rest escaped (the script below does the same). */
const code = (t: string) => esc(t).replace(/`([^`]+)`/g, '<code>$1</code>');
/** A room's link: a docs slug (with an anchor) as a site path, or a full address as it is. */
const href = (h: string) => {
	if (/^https:\/\//.test(h)) return h;
	const [slug, anchor] = h.split('#');
	return `${base}/${slug}/${anchor ? `#${anchor}` : ''}`;
};

const starts = STARTS.map((s) => {
	const r = ROOMS.find((x) => x.id === s.room);
	if (!r) throw new Error(`docs-site/rooms.mjs: start ${s.id} has no room ${s.room}`);
	const cmd = r.first.command as { any?: string; clickhouse?: string; postgres?: string };
	return {
		id: s.id,
		label: s.label,
		blurb: s.blurb,
		room: `${base}/for/${s.room}/`,
		title: r.title,
		works: r.works as string[],
		note: (r.first as { note?: string }).note ?? '',
		command: Object.fromEntries(DIALECTS.map((d) => [d.id, cmd.any ?? cmd[d.id as 'clickhouse' | 'postgres'] ?? ''])) as Record<string, string>,
		first: { label: (r.first.link as Link).label, href: href((r.first.link as Link).href) },
	};
});

const holds = (r: { dialect: string; plain: string; break: string }) => r.plain === 'pass' && r.break === 'caught';
const dialects = DIALECTS.map((d) => ({
	id: d.id,
	label: d.label,
	works: d.works,
	proven: record.rows.filter((r) => r.dialect === d.record && holds(r)).length,
}));
const forges = FORGES.map((f) => ({ id: f.id, label: f.label, line: `${f.label}: ${f.differs.join(' ')}` }));
const claimsHref = `${base}/claims/`;
const data = { starts, dialects, forges };

const [start] = starts;
const [dialect] = dialects;
const [forge] = forges;
const proofLine = (d: (typeof dialects)[number]) => `Proven: ${d.proven} claims on ${d.label}. `;
---
<section class="sy-picker not-content" aria-label="Where to start" style={`--sy-hat-mark: url(${base}/brand/hat-small.png)`}>
	<div class="switches">
		<div class="switch">
			<span id="sy-pick-db">Database</span>
			<div class="seg" role="group" aria-labelledby="sy-pick-db">
				{dialects.map((d, i) => <button type="button" data-pick="dialect" value={d.id} aria-pressed={String(i === 0)}>{d.label}</button>)}
			</div>
		</div>
		<div class="switch">
			<span id="sy-pick-forge">Forge</span>
			<div class="seg" role="group" aria-labelledby="sy-pick-forge">
				{forges.map((f, i) => <button type="button" data-pick="forge" value={f.id} aria-pressed={String(i === 0)}>{f.label}</button>)}
			</div>
		</div>
	</div>
	<nav class="tiles" aria-label="Starting points">
		{starts.map((s, i) => (
			<a class="tile" href={s.room} data-start={s.id} aria-current={i === 0 ? 'true' : undefined}>
				<Hat size={26} />
				<b>{s.label}</b>
				<small>{s.blurb}</small>
			</a>
		))}
	</nav>
	<nav class="roles" aria-label="By role">
		<span>Or start from your role:</span>
		{ROLES.map((r) => <a class="role" href={`${base}/for/${r.room}/`}><Hat size="small" />{r.label}</a>)}
	</nav>
	<div class="cards" aria-live="polite">
		<div class="card">
			<p class="h">Works</p>
			<ul class="hat-list" data-works>
				{[...start.works, ...dialect.works].map((w) => <li set:html={code(w)} />)}
				<li data-forge-line set:html={code(forge.line)} />
			</ul>
			<p class="proof"><span data-proof>{proofLine(dialect)}</span><a href={claimsHref}>Claims status</a></p>
		</div>
		<div class="card">
			<p class="h">First step</p>
			<p class="note" data-note hidden={!start.note} set:html={code(start.note)} />
			<pre><code data-command>{start.command[dialect.id]}</code></pre>
			<a class="go" data-first href={start.first.href}>{start.first.label}</a>
			<p class="more">More in <a data-room href={start.room}>{start.title}</a>: what differs on each database and forge, the proof, and what to read next.</p>
		</div>
	</div>
	<script type="application/json" data-picker-data set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
</section>

<script is:inline>
	(() => {
		// `code` spans as <code>, the rest escaped: the same as the server's code().
		const esc = (t) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
		const code = (t) => esc(t).replace(/`([^`]+)`/g, '<code>$1</code>');
		const key = 'sy-picker';
		const synced = 'starlight-synced-tabs__';
		for (const section of document.querySelectorAll('.sy-picker')) {
			const data = JSON.parse(section.querySelector('[data-picker-data]').textContent);
			const pick = { start: data.starts[0].id, dialect: data.dialects[0].id, forge: data.forges[0].id };
			try {
				const saved = JSON.parse(localStorage.getItem(key) || '{}');
				// Without a pick of its own, take the tabs a docs page last synced.
				const tab = (k, list) => list.find((x) => x.label === localStorage.getItem(synced + k))?.id;
				pick.dialect = saved.dialect || tab('dialect', data.dialects) || pick.dialect;
				pick.forge = saved.forge || tab('forge', data.forges) || pick.forge;
				if (saved.start) pick.start = saved.start;
			} catch {}
			const $ = (sel) => section.querySelector(sel);
			const show = () => {
				const start = data.starts.find((s) => s.id === pick.start) || data.starts[0];
				const dialect = data.dialects.find((d) => d.id === pick.dialect) || data.dialects[0];
				const forge = data.forges.find((f) => f.id === pick.forge) || data.forges[0];
				for (const b of section.querySelectorAll('button[data-pick]')) b.setAttribute('aria-pressed', String(pick[b.dataset.pick] === b.value));
				for (const t of section.querySelectorAll('[data-start]')) {
					if (t.dataset.start === start.id) t.setAttribute('aria-current', 'true');
					else t.removeAttribute('aria-current');
				}
				$('[data-works]').innerHTML = [...start.works, ...dialect.works].map((w) => `<li>${code(w)}</li>`).join('') + `<li data-forge-line>${code(forge.line)}</li>`;
				$('[data-proof]').textContent = `Proven: ${dialect.proven} claims on ${dialect.label}. `;
				$('[data-note]').innerHTML = code(start.note);
				$('[data-note]').hidden = !start.note;
				$('[data-command]').textContent = start.command[dialect.id];
				$('[data-first]').href = start.first.href;
				$('[data-first]').textContent = start.first.label;
				$('[data-room]').href = start.room;
				$('[data-room]').textContent = start.title;
				try {
					localStorage.setItem(key, JSON.stringify(pick));
					localStorage.setItem(synced + 'dialect', dialect.label);
					localStorage.setItem(synced + 'forge', forge.label);
				} catch {}
			};
			section.addEventListener('click', (e) => {
				const b = e.target.closest('button[data-pick]');
				if (b) {
					pick[b.dataset.pick] = b.value;
					show();
					return;
				}
				const t = e.target.closest('[data-start]');
				if (!t || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
				// The picked tile opens its room; another one is picked first.
				if (t.dataset.start === pick.start) return;
				e.preventDefault();
				pick.start = t.dataset.start;
				show();
			});
			show();
		}
	})();
</script>

<style>
	.sy-picker {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.1rem;
		max-width: 64rem;
		margin: 0.5rem auto 2.5rem;
		font-size: var(--sl-text-sm);
		overflow-wrap: anywhere;
	}
	.switches {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
		align-items: center;
		justify-content: center;
	}
	.switch {
		display: flex;
		gap: 0.6rem;
		align-items: center;
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}
	.seg {
		display: inline-flex;
		flex-wrap: wrap;
		padding: 3px;
		border: 1px solid var(--sy-rule);
		border-radius: 0.55rem;
		background: var(--sy-panel);
		font-size: var(--sl-text-sm);
		letter-spacing: normal;
		text-transform: none;
	}
	.seg button {
		padding: 0.35rem 0.8rem;
		font: inherit;
		font-weight: 500;
		color: var(--sl-color-gray-3);
		background: none;
		border: 0;
		border-radius: 0.4rem;
		cursor: pointer;
	}
	.seg button:hover {
		color: var(--sl-color-white);
	}
	.seg button[aria-pressed='true'] {
		color: var(--sl-color-black);
		background: var(--sl-color-white);
	}
	.tiles {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.5rem;
	}
	.tile {
		position: relative;
		display: grid;
		gap: 0.4rem;
		align-content: start;
		padding: 0.8rem 0.9rem;
		color: var(--sl-color-white);
		text-decoration: none;
		background: var(--sy-panel);
		border: 1px solid var(--sy-rule);
		border-top: 2px solid var(--sy-rule);
		border-radius: 0.6rem;
		transition: border-color 0.15s;
	}
	.tile :global(.sy-hat) {
		opacity: 0.35;
		transition: opacity 0.15s;
	}
	.tile b {
		line-height: 1.3;
	}
	.tile small {
		font-size: var(--sl-text-xs);
		line-height: 1.35;
		color: var(--sl-color-gray-3);
	}
	.tile:hover {
		border-color: var(--sy-brass);
	}
	.tile:hover :global(.sy-hat) {
		opacity: 0.7;
	}
	/* The picked tile wears the star in its corner. */
	.tile[aria-current='true'] {
		border-color: var(--sy-rule);
		border-top-color: var(--sy-brass);
		box-shadow: inset 0 0 0 1px var(--sy-brass);
	}
	.tile[aria-current='true'] :global(.sy-hat) {
		opacity: 1;
	}
	.tile[aria-current='true']::after {
		content: '';
		position: absolute;
		top: 0.6rem;
		right: 0.6rem;
		width: 15px;
		height: 15px;
		background: var(--sy-star) center / contain no-repeat;
		image-rendering: pixelated;
	}
	.roles {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
	}
	.roles > span {
		margin-right: 0.25rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.role {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.35rem 0.8rem 0.35rem 0.5rem;
		font-weight: 500;
		color: var(--sl-color-white);
		text-decoration: none;
		background: var(--sy-panel);
		border: 1px solid var(--sy-rule);
		border-radius: 0.5rem;
	}
	.role:hover,
	.role:focus-visible {
		border-color: var(--sy-brass);
	}
	.cards {
		display: grid;
		grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
		gap: 0.75rem;
	}
	.card {
		display: grid;
		align-content: start;
		gap: 0.7rem;
		padding: 1rem 1.15rem;
		background: var(--sy-panel);
		border: 1px solid var(--sy-rule);
		border-top: 1px solid var(--sy-brass);
		border-radius: 0.6rem;
		color: var(--sl-color-gray-2);
		line-height: 1.55;
	}
	.card p {
		margin: 0;
	}
	.h {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}
	.hat-list {
		display: grid;
		gap: 0.45rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.hat-list :global(li) {
		position: relative;
		margin: 0;
		padding-left: 1.85rem;
		color: var(--sl-color-white);
	}
	.hat-list :global(li)::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.1em;
		width: 22px;
		height: 20px;
		background: var(--sy-hat-mark) center / contain no-repeat;
	}
	.card :global(code) {
		font-size: 0.85em;
		padding: 0.05em 0.3em;
		border: 1px solid var(--sy-rule);
		border-radius: 0.3rem;
		background: var(--sl-color-gray-6);
	}
	.card pre {
		margin: 0;
		padding: 0.65rem 0.8rem;
		overflow-x: auto;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		white-space: pre-wrap;
		color: var(--sl-color-gray-1);
		border: 1px solid var(--sy-rule);
		border-radius: 0.45rem;
		background: var(--sl-color-black);
	}
	.card pre code {
		border: 0;
		padding: 0;
		background: none;
	}
	.proof {
		padding-top: 0.75rem;
		border-top: 1px solid var(--sy-rule);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.proof a,
	.more a {
		color: var(--sy-accent);
	}
	.go {
		justify-self: start;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.55rem 1rem;
		font-weight: 600;
		color: var(--sl-color-black);
		text-decoration: none;
		background: var(--sy-accent);
		border-radius: 0.5rem;
	}
	.go::after {
		content: '\2192';
	}
	.go:hover {
		filter: brightness(1.1);
	}
	.more {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	@media (max-width: 52rem) {
		.tiles {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.cards {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
