---
// SQL Yodeler's logo, the pixel-art cowboy hat with a database on it. `scale`
// shows the 78x72 art (an SVG with a square per art pixel) at a whole
// multiple, so every art pixel stays square and sharp; `small` is the 18x16
// mark for inline use, a PNG at twice that size resampled once from the art.
// Decorative by default (alt=""), since a word beside it names SQL Yodeler.
// The art is transparent, so the hat sits on whatever is behind it.
// scripts/brand.py draws both files.
interface Props {
	scale?: number | 'small';
	alt?: string;
	class?: string;
}
const { scale = 1, alt = '', class: className } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const small = scale === 'small';
const n = small ? 1 : scale;
---
<span class:list={['sy-hat-tile', className]} style={`padding:${small ? 2 : 4 * n}px ${small ? 3 : 4 * n}px;border-radius:${small ? 5 : 6 * n}px`}><img
	class="sy-hat"
	src={small ? `${base}/brand/hat-small.png` : `${base}/brand/hat.svg`}
	width={small ? 18 : 78 * n}
	height={small ? 16 : 72 * n}
	alt={alt}
	decoding="async"
/></span>

<style>
	/* The span keeps the hat's padding and centering; the art itself is transparent. */
	.sy-hat-tile {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		vertical-align: middle;
		line-height: 0;
	}
	.sy-hat {
		display: inline-block;
		max-width: none;
		height: auto;
		vertical-align: middle;
	}
</style>
