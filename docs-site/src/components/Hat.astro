---
// SQL Yodeler's logo, the cowboy hat with a database on it. `size` is its
// height on the page in CSS pixels (the width follows the art's 728:672);
// `small` is the 22x20 mark for inline use. Each file is drawn at twice the
// size it is shown, resampled once from the render (scripts/brand.py).
// Decorative by default (alt=""), since a word beside it names SQL Yodeler.
interface Props {
	size?: number | 'small';
	alt?: string;
	class?: string;
}
const { size = 36, alt = '', class: className } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const small = size === 'small';
const h = small ? 20 : size;
const w = small ? 22 : Math.round((h * 728) / 672);
---
<img class:list={['sy-hat', className]} src={small ? `${base}/brand/hat-small.png` : `${base}/brand/hat.png`} width={w} height={h} alt={alt} decoding="async" />

<style>
	.sy-hat {
		display: inline-block;
		max-width: none;
		height: auto;
		vertical-align: middle;
	}
</style>
