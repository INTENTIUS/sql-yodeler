---
// Starlight's page title, then the tools for an agent reading the page: a
// "Copy page as Markdown" button (the same text llms-full.txt carries for
// this page), a pointer to llms.txt, and, on a page with a prompt, the prompt
// card (AgentPrompt.astro).
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { pageMarkdown, pageUrl } from '../markdown';
import AgentPrompt from './AgentPrompt.astro';

const { entry } = Astro.locals.starlightRoute;
const real = entry.id !== '404';
const prompt = entry.data.prompt;
const markdown = pageMarkdown({ title: entry.data.title, url: pageUrl(entry.id), prompt, body: entry.data.markdown ?? entry.body ?? '' });
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Default />
{real && (
	<div class="sy-page-tools not-content">
		<button type="button" class="sy-page-copy" data-copy={markdown} data-label="Copy page as Markdown">Copy page as Markdown</button>
		<a href={`${base}/llms.txt`}>llms.txt</a>
		<span>lists every page for an agent</span>
	</div>
)}
{real && prompt && <AgentPrompt />}

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('.sy-page-copy')) {
		const label = button.dataset.label ?? button.textContent ?? '';
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(button.dataset.copy ?? '');
				button.textContent = 'Copied';
			} catch {
				button.textContent = 'Copy failed; use llms-full.txt';
			}
			setTimeout(() => (button.textContent = label), 2000);
		});
	}
</script>

<style>
	.sy-page-tools {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 0.6rem;
		margin-top: 0.75rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	button {
		font: inherit;
		font-weight: 500;
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
		border: 1px solid var(--sy-rule);
		border-radius: 0.4rem;
		padding: 0.2rem 0.7rem;
		cursor: pointer;
	}
	button:hover {
		border-color: var(--sy-brass);
	}
	a {
		color: var(--sl-color-accent-high);
		font-weight: 500;
	}
</style>
