---
// Starlight's footer, with the hat and the name under it on every page,
// linking home.
import Default from '@astrojs/starlight/components/Footer.astro';
import Hat from './Hat.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Default />
<p class="sy-foot not-content">
	<a href={`${base}/`}><Hat /><span>SQL Yodeler</span></a>
</p>

<style>
	.sy-foot {
		margin: 2rem 0 1rem;
		text-align: center;
	}
	.sy-foot a {
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	.sy-foot a:hover {
		color: var(--sl-color-white);
	}
</style>
