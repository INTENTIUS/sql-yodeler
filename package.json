{
  "name": "@intentius/sql-yodeler",
  "version": "0.11.0",
  "description": "Schema changes for ClickHouse and Postgres, and the ops they imply, on chant's sql lexicon",
  "keywords": [
    "clickhouse",
    "postgres",
    "postgresql",
    "schema",
    "migrations",
    "declarative",
    "ddl",
    "backfill",
    "cli"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INTENTIUS/sql-yodeler.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./webhook": {
      "types": "./dist/notify/verify.d.ts",
      "default": "./dist/notify/verify.js"
    }
  },
  "bin": {
    "yodel": "dist/bin.js"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "prepare": "npm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test",
    "claims": "npm run build && tsx scenarios/run.ts",
    "release": "bash scripts/release.sh",
    "workflows": "tsx .github/src/render.ts",
    "templates:check": "tsx scripts/templates-check.ts",
    "templates:render": "tsx scripts/templates-render.ts",
    "claims:page": "tsx scenarios/status-page.ts",
    "bench": "npm run build && tsx bench/run.ts",
    "grant": "tsx scripts/grant.ts"
  },
  "dependencies": {
    "@intentius/chant": "^0.124.55",
    "@intentius/chant-lexicon-forgejo": "^0.124.55",
    "@intentius/chant-lexicon-github": "^0.124.55",
    "@intentius/chant-lexicon-gitlab": "^0.124.55",
    "@intentius/chant-lexicon-sql": "^0.124.55",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intentius/chant-lexicon-docker": "^0.124.55",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "pg": "^8.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
